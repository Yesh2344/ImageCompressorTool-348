# .env.example – copy to .env and modify as needed

# Root directory to scan (default: current directory)
IMG_DIR=.

# JPEG quality (1-100)
JPEG_QUALITY=85

# PNG optimization level (0-7)
PNG_LEVEL=2

# Enable parallel processing (true/false)
PARALLEL=false

# Path to JSON log file
LOG_FILE=compress.log.json